/* [Rofi Documentation](https://davatorium.github.io/rofi/) */
configuration {
  disable-history: false;
  display-calc: " Calc";
  display-drun: " Apps";
  display-emoji: "󰞅 Emojis";
  display-run: " Commands";
  display-window: " Windows";
  drun-display-format: "{icon} {name}";
  font: "Maple Mono NF 12";
  hide-scrollbar: true;
  modes: "drun";
  terminal: "ghostty";
  window-format: "{icon} {t}";
}

//
@import "normalize"
@theme "cendre"
@import "textbox-icons"
//

/* Layout tokens: radius pair plus Tailwind width scale.
 * Window currently uses @w-sm. Swap one name to rescale. */
* {
  radius-lg: 8px;
  radius-md: 6px;
  w-xs: 480px;
  w-sm: 640px;
  w-md: 768px;
  w-lg: 1024px;
  w-xl: 1280px;
  w-2xl: 1536px;
}

/* shadcn/ui command-palette: flat popover, 1px border, 8px shell / 6px rows,
 * ash-only chrome, ember reserved for focus + active tab. Single column —
 * set listview columns back to 3 for the old app-grid. */
window {
  background-color: @popover;
  border: 1px;
  border-color: @border;
  border-radius: @radius-lg;
  padding: 12px;
  width: @w-sm;
  height: 0px;
}

mainbox {
  background-color: @popover;
  spacing: 12px;
}

icon-search {
  expand: false;
  filename: "search-symbolic";
}

inputbar {
  background-color: @card;
  border: 1px;
  border-color: @input-border;
  border-radius: @radius-md;
  children:
    [ textbox-icon-search,
    entry];
  padding: 10px 12px;
}

prompt {
  text-color: @primary;
}

textbox-prompt-colon {
  expand: false;
  str: ":";
}

entry {
  background-color: @card;
  placeholder: "Search…";
  placeholder-color: @muted-fg;
  cursor-color: @primary;
  selection-background: @accent;
  selection-foreground: @foreground;
  text-color: @foreground;
}

/* Single column here; emoji gets its grid via its own launcher
 * (dwm config.def.h emojis[] adds -theme-str 'listview {columns: 3;}').
 * RASI has no per-modi conditional, so this can't live in the theme. */
listview {
  background-color: @popover;
  columns: 1;
  lines: 8;
}

element {
  background-color: @popover;
  border-radius: @radius-md;
  padding: 8px 10px;
  text-color: @foreground;
}

element-icon {
  background-color: @popover;
  size: 22px;
}

element-text {
  background-color: inherit;
  text-color: inherit;
}

element-icon selected {
  background-color: @accent;
}

element selected {
  background-color: @accent;
  text-color: @fg;
}

element urgent {
  text-color: @destructive;
}

element selected.urgent {
  background-color: @destructive;
  text-color: @popover;
}

textbox {
  text-color: @fg-dim;
}

button {
  border-radius: @radius-md;
  horizontal-align: 0.5;
  padding: 8px;
  text-color: @muted-fg;
  vertical-align: 0.5;
}

button selected {
  background-color: @accent;
  text-color: @primary;
}

scrollbar {
  handle-color: @border;
  handle-width: 4px;
}
