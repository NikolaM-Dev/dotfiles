/* [Rofi Documentation](https://davatorium.github.io/rofi/) */
configuration{
    disable-history: false;
    display-calc: " Calc";
    display-drun: " Apps";
    display-emoji: "󰞅 Emojis";
    display-run: " Commands";
    display-window: " Windows";
    drun-display-format: "{icon} {name}";
    font: "Maple Mono NF 12";
    hide-scrollbar: true;
    modes: "drun";
    show-icons: true;
    terminal: "ghostty";
    window-format: "{icon} {t}";
}

@theme "cendre"
@import "textbox-icons"

/* shadcn/ui command-palette: flat popover, 1px border, 8px shell / 6px rows,
 * ash-only chrome, ember reserved for focus + active tab. Single column —
 * set listview columns back to 3 for the old app-grid. */

element-icon,
element-text,
mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    background-color: @bg-col;
    border: 1px;
    border-color: @border-col;
    border-radius: 8px;
    padding: 12px;
    width: 640px;
    height: 0px;
}

mainbox {
    background-color: transparent;
    spacing: 12px;
}

icon-search {
    expand: false;
    filename: "search-symbolic";
    background-color: transparent;
}

inputbar {
    background-color: @bg-col-light;
    border: 1px;
    border-color: @input-border;
    border-radius: 6px;
    children: [ textbox-icon-search, entry ];
    padding: 10px 12px;
}

prompt {
    background-color: transparent;
    text-color: @primary;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    background-color: transparent;
    placeholder: "Search…";
    placeholder-color: @grey;
    cursor-color: @primary;
    selection-background: @selected-col;
    selection-foreground: @fg-col;
    text-color: @fg-col;
}

/* Single column here; emoji gets its grid via its own launcher
 * (dwm config.def.h emojis[] adds -theme-str 'listview {columns: 3;}').
 * RASI has no per-modi conditional, so this can't live in the theme. */
listview {
    background-color: transparent;
    border: 0px 0px 0px;
    columns: 1;
    lines: 8;
    spacing: 0px;
    padding: 0px 0px 0px;
}

element {
    background-color: transparent;
    border-radius: 6px;
    padding: 8px 10px;
    text-color: @fg-col;
}

element-icon {
    size: 22px;
}

element selected {
    background-color: @selected-col;
    text-color: @fg;
}

element urgent {
    text-color: @destructive;
}

element selected.urgent {
    background-color: @destructive;
    text-color: @bg-col;
}

message {
    background-color: transparent;
}

textbox {
    background-color: transparent;
    text-color: @fg-dim;
}

mode-switcher {
    background-color: transparent;
}

button {
    background-color: transparent;
    border-radius: 6px;
    horizontal-align: 0.5;
    padding: 8px;
    text-color: @grey;
    vertical-align: 0.5;
}

button selected {
    background-color: @selected-col;
    text-color: @primary;
}

scrollbar {
    background-color: transparent;
    handle-color: @border-col;
    handle-width: 4px;
}
