/* cendre-medium — same pigments and ink, one step lighter ground.
 * Installs under its own name so two depths never collide on one entry.
 */
* {
  /* grounds — medium */
  bg-deep: #141110;
  bg0: #1d1917;
  bg1: #26211f;
  bg2: #312a28;
  bg3: #3d3633;
  bg4: #4e4541;
  bg5: #625753;

  /* ink — shared by every depth */
  fg: #e6d5c2;
  fg-dim: #a09384;
  comment: #73665b;
  gutter: #4e4641;

  /* pigments — syntax roles, not chrome */
  brass: #fcba81;
  ember: #ea9875;
  sap: #99af6b;
  cinder: #d1766e;
  frost: #4e89a2;

  /* diagnostics — higher chroma than any pigment, never clash */
  error: #d25780;
  warn: #f4a21c;
  ok: #43b16a;
  hint: #20c9cb;
  info: #58bdff;

  /* tinted grounds for visual / diff */
  vis: #36241d;
  add: #262c1b;
  del: #372321;
  mod: #182c35;

  /* shadcn/ui aliases */
  background: @bg-deep;
  card: @bg1;
  popover: @bg-deep;
  foreground: @fg;
  muted: @bg2;
  muted-fg: @comment;
  border: @bg4;
  input-border: @bg3;
  accent: @bg2;
  accent-fg: @fg;
  primary: @ember;
  ring: @ember;
  destructive: @error;
}
