#!/usr/bin/env bash
set -euo pipefail

# --- logging ---
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ $(tput colors 2>/dev/null || echo 0) -ge 8 ]]; then
  RED=$(tput setaf 1)
  YELLOW=$(tput setaf 3)
  GREEN=$(tput setaf 2)
  CYAN=$(tput setaf 6)
  RESET=$(tput sgr0)
else
  RED=""; YELLOW=""; GREEN=""; CYAN=""; RESET=""
fi

log_info()  { echo -e "${GREEN}[INFO]${RESET} $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${RESET} $*" >&2; }
log_error() { echo -e "${RED}[ERROR]${RESET} $*" >&2; }
log_step()  { echo -e "${CYAN}[INFO]${RESET} $*"; }

BACKUP_DIR="$HOME/backups/zen"
TARGET_DIR="$HOME/.config/zen"

close_zen() {
  if ! pgrep -x "zen-bin" >/dev/null 2>&1; then
    log_info "Zen is not running."
    return 0
  fi
  log_step "Closing Zen..."
  pkill -TERM -x "zen-bin" || true
  for i in {1..30}; do
    if ! pgrep -x "zen-bin" >/dev/null 2>&1; then
      log_info "Zen closed."
      return 0
    fi
    sleep 1
  done
  log_warn "Zen did not exit gracefully, forcing..."
  pkill -KILL -x "zen-bin" || true
  sleep 2
}

relaunch_zen() {
  log_step "Relaunching Zen..."
  nohup zen-browser >/dev/null 2>&1 &
  disown || true
  log_info "Zen relaunched (PID $!)."
}

pick_backup() {
  local backups
  mapfile -t backups < <(ls -1t "$BACKUP_DIR"/nkl-*.tar.gz 2>/dev/null || true)

  if (( ${#backups[@]} == 0 )); then
    log_error "No backups found in $BACKUP_DIR"
    exit 1
  fi

  # if argument given, use it
  if [[ $# -gt 0 ]]; then
    local arg="$1"
    # allow bare filename or full path
    if [[ -f "$arg" ]]; then
      echo "$arg"
      return 0
    elif [[ -f "$BACKUP_DIR/$arg" ]]; then
      echo "$BACKUP_DIR/$arg"
      return 0
    else
      log_error "File not found: $arg"
      exit 1
    fi
  fi

  # interactive pick
  if command -v fzf >/dev/null 2>&1; then
    local choice
    choice=$(printf "%s\n" "${backups[@]}" | xargs -I{} bash -c 'echo "$(stat -c "%y %s" "{}" | cut -c1-16) $(du -h "{}" | cut -f1) {}"' | fzf --prompt="Restore> " --height=15 --reverse | awk '{print $NF}')
    if [[ -z "$choice" ]]; then
      log_warn "No selection, aborting."
      exit 1
    fi
    echo "$choice"
  else
    log_step "Available backups:"
    select choice in "${backups[@]}"; do
      if [[ -n "$choice" ]]; then
        echo "$choice"
        break
      fi
    done
  fi
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Usage: n-zen-restore [backup.tar.gz]"
    echo "  No arg  -> pick with fzf (or numbered menu)"
    echo "  With arg -> restore that file (name or full path)"
    echo "Backups in: $BACKUP_DIR"
    ls -1 "$BACKUP_DIR"/nkl-*.tar.gz 2>/dev/null | head -n 20 || echo "  (none yet)"
    exit 0
  fi

  mkdir -p "$BACKUP_DIR"

  local selected
  selected=$(pick_backup "$@")
  log_step "Selected: $selected"

  # confirm
  if [[ -t 0 ]]; then
    echo -e "${YELLOW}[WARN] This will overwrite ~/.config/zen/87cp3bps.nkl and profiles.ini${RESET}"
    read -rp "Continue? [y/N] " ans
    if [[ "$ans" != "y" && "$ans" != "Y" ]]; then
      log_warn "Aborted."
      exit 1
    fi
  fi

  # safety: trap relaunch even on failure
  trap relaunch_zen EXIT

  close_zen
  sleep 1

  log_step "Restoring $selected -> $TARGET_DIR"
  tar -xzf "$selected" -C "$TARGET_DIR"

  log_info "Restore done. Verifying..."
  if [[ -d "$TARGET_DIR/87cp3bps.nkl" && -f "$TARGET_DIR/profiles.ini" ]]; then
    log_info "Verified: 87cp3bps.nkl and profiles.ini present."
  else
    log_error "Restore verification failed."
    exit 1
  fi

  trap - EXIT
  relaunch_zen
}

main "$@"
