#!/usr/bin/env bash

function main {
  if [[ $1 == "--stage-all" ]]; then
    git add --all
  fi

  # If nothing has changed, do nothing
  if git diff --staged --quiet; then
    echo "[INFO] Skipping commit, nothing changed"
    return
  fi

  git commit -m "feat: add backup at $(date '+%H:%M:%S') on $(date "+%Y-%m-%d")"
  echo "[INFO] Commit successful"
}

main "$@"
