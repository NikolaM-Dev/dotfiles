[user]
name = Juan David Merchan Torres
email = juan1014166@gmail.com

[core]
editor = nvim
excludesFile = ~/.config/git/ignore
pager = hunk pager

[init]
defaultBranch = main

[pull]
rebase = false

[fetch]
prune = true

[push]
autoSetupRemote = true

[diff]
tool = hunk

[difftool "hunk"]
cmd = hunk difftool \"$LOCAL\" \"$REMOTE\" \"$MERGED\"

[difftool]
prompt = false

[credential "https://github.com"]
helper =
helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
helper =
helper = !/usr/bin/gh auth git-credential
