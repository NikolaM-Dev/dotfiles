{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "*",
      "effect": "allow",
      "resource": "*"
    }
  ],
  "permission": {
    "question": "deny"
  },
  "tools": {
    "question": false
  },
  "provider": {
    "ollama": {
      "models": {
        "gemma3:4b": {
          "name": "gemma3:4b"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  },
  "mcp": {
    "servers": {
      "engram": {
        "command": ["/home/nikola/go/bin/engram", "mcp", "--tools=agent"],
        "type": "local"
      }
    }
  }
}
